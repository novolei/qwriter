{
  "name": "qwriter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "desktop": "node scripts/desktop.mjs dev",
    "tauri": "tauri",
    "test": "vitest run",
    "format": "prettier --write src scripts *.config.ts",
    "desktop:build": "node scripts/desktop.mjs build --debug --no-bundle",
    "desktop:package:windows": "node scripts/desktop.mjs build --bundles nsis",
    "desktop:package:macos": "node scripts/desktop.mjs build --target universal-apple-darwin --bundles dmg",
    "check": "node scripts/check.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "bindings:generate": "node scripts/bindings.mjs",
    "bindings:check": "node scripts/bindings.mjs --check",
    "icons:generate": "node scripts/icons.mjs",
    "predev": "node scripts/capture-runtime.mjs",
    "prebuild": "node scripts/capture-runtime.mjs",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@lezer/highlight": "1.2.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extension-code-block": "^3.31.3",
    "@tiptap/extension-floating-menu": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/markdown": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "react-screenshots": "0.5.22",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/diff": "^7.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.0"
  }
}
