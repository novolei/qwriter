{
  "identifier": "default",
  "description": "Editor window; file access is granted through native dialogs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "allow-ai-complete",
    "allow-list-models",
    "allow-model-verify",
    "allow-credential-read",
    "allow-credential-write",
    "allow-credential-remove",
    "allow-comfy-request",
    "allow-library-load",
    "allow-library-save",
    "allow-library-history",
    "allow-git-inspect",
    "allow-git-file-diff",
    "allow-git-init",
    "allow-git-commit",
    "allow-ai-stream",
    "allow-ai-cancel",
    "allow-agent-run",
    "allow-agent-cancel",
    "allow-memory-list",
    "allow-memory-save",
    "allow-memory-search",
    "allow-knowledge-search",
    "allow-knowledge-source",
    "allow-agent-session-save",
    "allow-agent-sessions",
    "allow-media-pick",
    "allow-media-import",
    "allow-media-asset",
    "allow-media-path",
    "allow-media-export",
    "allow-link-preview",
    "allow-open-external",
    "allow-cards-list",
    "allow-card-save",
    "allow-capture-open",
    "allow-capture-clipboard",
    "allow-capture-screens",
    "allow-capture-environment",
    "allow-capture-request-access",
    "allow-capture-shortcut-errors",
    "allow-capture-pending-insert",
    "allow-capture-pin",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "core:resources:allow-close",
    "core:image:allow-rgba",
    "core:image:allow-size",
    "core:image:allow-from-bytes",
    "fs:allow-write-file"
  ]
}
