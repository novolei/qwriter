{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qwriter",
  "version": "0.2.0",
  "identifier": "studio.qwriter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Qwriter",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#F8F7F3"
      }
    ],
    "security": {
      "csp": "default-src 'self'; font-src 'self' data:; img-src 'self' asset: http: https: data: blob:; media-src 'self' asset: http: https: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/assets/*", "$APPCACHE/capture/*"] },
      "capabilities": [
        "default", "capture", "pin"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
